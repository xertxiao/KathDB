+[metadata]
+query_id = 2
+data = "ecomm, scale factor 1000"
+modalities = ["image", "tabular"]
+
+[definition]
+natural_language = """
+Decide the intended wearer gender of each apparel item from its product image only
+-- not the product name or any text field. Gender means who the garment is designed
+for: men's, women's, or unisex.
+
+Among brands that sell at least two apparel products and that also sell at least one
+footwear product, find the brands whose apparel products all target the same gender
+-- every apparel item they sell shares one intended gender. Output one row per
+qualifying brand with a single column ``id`` holding the brand name.
+"""
+# Ground truth: SQL over files/ecomm/data/sf_1000 (keys on the hidden catalog label).
+ground_truth = """
+WITH ap AS (
+  SELECT brandName, gender AS k
+  FROM read_parquet('styles_details.parquet')
+  WHERE masterCategory.typeName = 'Apparel'
+),
+fwb AS (
+  SELECT DISTINCT brandName FROM read_parquet('styles_details.parquet')
+  WHERE masterCategory.typeName = 'Footwear'
+)
+SELECT brandName AS id
+FROM ap
+WHERE brandName IN (SELECT brandName FROM fwb)
+GROUP BY brandName
+HAVING COUNT(*) >= 2 AND COUNT(DISTINCT k) = 1
+"""
+accuracy_metric = "f1-score"

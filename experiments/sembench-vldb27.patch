+[metadata]
+query_id = 1
+data = "ecomm, scale factor 1000"
+modalities = ["image", "tabular"]
+
+[definition]
+natural_language = """
+Decide what broad kind of garment each apparel item is from its product image only -- not from the product name or any text field. Broad kind means the general category of garment: top-wear (e.g., shirts, t-shirts, jackets, sweaters), bottom-wear (e.g., jeans, trousers, shorts, skirts), innerwear, or similar.
+
+Among brands that sell at least two apparel products, find the brands whose
+apparel products are all the same broad kind of garment -- every apparel item
+they sell falls in the same broad kind -- and that also sell at least one
+footwear product. Return one row per qualifying brand with a single column
+``id`` holding the brand name.
+"""
+# Ground truth: SQL over files/ecomm/data/sf_1000 (keys on the hidden catalog label).
+ground_truth = """
+WITH ap AS (
+  SELECT brandName, subCategory.typeName AS atype
+  FROM read_parquet('styles_details.parquet')
+  WHERE masterCategory.typeName = 'Apparel'
+),
+fwb AS (
+  SELECT DISTINCT brandName FROM read_parquet('styles_details.parquet')
+  WHERE masterCategory.typeName = 'Footwear'
+)
+SELECT brandName AS id
+FROM ap
+WHERE brandName IN (SELECT brandName FROM fwb)
+GROUP BY brandName
+HAVING COUNT(*) >= 2 AND COUNT(DISTINCT atype) = 1
+"""
+accuracy_metric = "f1-score"

+"""Additional scenario: 10 image-judgment + aggregate queries.
+
+Q1-Q4 run on the E-Commerce data at scale factor 1000; Q5-Q10 on the MMQA images
+at scale factor 400 grouped into albums (``files/additional/data/mmqa_albums_sf400.csv``,
+which also carries the frozen per-image labels the ground truth is computed from;
+see ``files/additional/make_gt.py``).
+"""
+
+from __future__ import annotations
+
+import glob
+import os
+from typing import Any, Dict, List
+
+import duckdb
+import pandas as pd
+import tomli
+
+ADDITIONAL_FILES_DIR = os.path.abspath(
+    os.path.join(os.path.dirname(__file__), "..", "..", "..", "files", "additional")
+)
+FILES_DIR = os.path.dirname(ADDITIONAL_FILES_DIR)
+
+ECOMM_SCALE_FACTOR = 1000
+MMQA_SCALE_FACTOR = 400
+ECOMM_QUERY_IDS = {1, 2, 3, 4}
+MMQA_QUERY_IDS = {5, 6, 7, 8, 9, 10}
+
+
+class AdditionalScenario:
+    def __init__(self, scale_factor: int = None):
+        # The scale factors are fixed per query family; ``scale_factor`` is ignored.
+        self.scale_factor = scale_factor
+        self.queries = self._load_queries()
+
+    def _load_queries(self) -> Dict[int, Any]:
+        queries = {}
+        for file in glob.glob(os.path.join(ADDITIONAL_FILES_DIR, "queries", "*.toml")):
+            with open(file, "rb") as f:
+                data = tomli.load(f)
+            queries[data["metadata"]["query_id"]] = data
+        return queries
+
+    @staticmethod
+    def ecomm_data_dir() -> str:
+        return os.path.join(FILES_DIR, "ecomm", "data", f"sf_{ECOMM_SCALE_FACTOR}")
+
+    @staticmethod
+    def mmqa_data_dir() -> str:
+        return os.path.join(FILES_DIR, "mmqa", "data", f"sf_{MMQA_SCALE_FACTOR}")
+
+    @staticmethod
+    def albums_csv() -> str:
+        return os.path.join(ADDITIONAL_FILES_DIR, "data", "mmqa_albums_sf400.csv")
+
+    def setup_scenario(self, systems: List[str]) -> None:
+        from scenario.ecomm.ecomm_scenario import EcommScenario
+        from scenario.mmqa.mmqa_scenario import MMQAScenario
+
+        EcommScenario(scale_factor=ECOMM_SCALE_FACTOR).setup_scenario(systems)
+        MMQAScenario(scale_factor=MMQA_SCALE_FACTOR).setup_scenario(systems)
+
+    def discover_available_queries(self, system_name: str = None) -> List[int]:
+        return sorted(self.queries)
+
+    def get_nl_query_text(self, query_id: int) -> str:
+        return self.queries[int(query_id)]["definition"]["natural_language"].strip()
+
+    def get_ground_truth(self, query_id: int) -> pd.DataFrame:
+        definition = self.queries[int(query_id)]["definition"]
+        if int(query_id) in ECOMM_QUERY_IDS:
+            con = duckdb.connect()
+            con.execute(f"set file_search_path = '{self.ecomm_data_dir()}'")
+            df = con.execute(definition["ground_truth"]).df()
+            con.close()
+            return df
+        return pd.DataFrame({"id": list(definition["ground_truth"])})
+
+    def get_accuracy_measure_for_query(self, query_id: int) -> str:
+        return self.queries[int(query_id)]["definition"]["accuracy_metric"]

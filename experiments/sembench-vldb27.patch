+        db.register_table(
+            lizzy,
+            "lizzy_caplan_text_data",
+            description=(
+                "A table with textual descriptions of movies that Lizzy Caplan "
+                "appeared in, including title and text columns"
+            ),
+        )
+        db.register_table(
+            tampa,
+            "tampa_international_airport",
+            description=(
+                "A table with airline information at Tampa International Airport, "
+                "including Airlines and Destinations columns"
+            ),
+        )
+        db.register_table(
+            ap_warrior,
+            "ap_warrior",

diff --git a/src/runner/generic_kathdb_runner/generic_kathdb_runner.py b/src/runner/generic_kathdb_runner/generic_kathdb_runner.py
new file mode 100644
index 0000000..30d4c1f
--- /dev/null
+++ b/src/runner/generic_kathdb_runner/generic_kathdb_runner.py
@@ -0,0 +1,162 @@
+"""SemBench runner for KathDB (https://github.com/xertxiao/KathDB).
+
+Each query gets a fresh KathDB instance (its own catalog and worker); the function
+library under ``KATHDB_FN_DIR`` (default ``files/<use_case>/kathdb_fn_lib``) is
+shared across queries. Scenario subclasses provide the query text and the tables.
+
+Settings (environment):
+  KATHDB_AI_OP_MODEL          model the generated code calls per record (default openai/gpt-4o-mini)
+  KATHDB_LOGICAL_REWRITE      true/false, run the grouping optimizer (default true)
+  KATHDB_PHY_OPT              true/false, allow physical optimizations (default false)
+  KATHDB_PREBUILT_FUNCTIONS   true/false (default true)
+  KATHDB_GENERATED_FUNCTIONS  true/false, reuse + save functions across queries (default true)
+  KATHDB_NUM_EXECUTOR_WORKERS worker processes (default 1)
+  KATHDB_WORKER_ENV           existing conda env for the worker (default: KathDB provisions one)
+  KATHDB_FN_DIR               function library directory
+The planner model is ``--model`` (a ``provider/model`` id).
+"""
+
+from __future__ import annotations
+
+import os
+import shutil
+import tempfile
+import time
+from pathlib import Path
+from typing import Dict, List
+
+import pandas as pd
+from kathdb import KathDB
+from kathdb.config import KathDBConfig
+
+from ..generic_runner import GenericQueryMetric, GenericRunner
+
+_PLAN_STAGES = ("parser", "plan_gen", "grouping", "codegen")
+
+
+def _env_bool(key: str, default: bool) -> bool:
+    val = os.environ.get(key)
+    if val is None or not val.strip():
+        return default
+    return val.strip().lower() in ("1", "true", "yes", "on")
+
+
+class GenericKathDBRunner(GenericRunner):
+    """Base runner; subclasses implement ``_query_text`` and ``_register_tables``."""
+
+    QUERY_IDS: List[int] = []
+
+    def __init__(
+        self,
+        use_case: str,
+        scale_factor: int,
+        model_name: str = "anthropic/claude-opus-5",
+        concurrent_llm_worker: int = 1,
+        skip_setup: bool = False,
+        **kwargs,
+    ):
+        super().__init__(use_case, scale_factor, model_name, concurrent_llm_worker, skip_setup)
+        self._worker_env = os.environ.get("KATHDB_WORKER_ENV", "").strip() or None
+
+    def get_system_name(self) -> str:
+        return "kathdb"
+
+    # -- scenario hooks -------------------------------------------------------
+
+    def _query_text(self, query_id: int) -> str:
+        raise NotImplementedError
+
+    def _register_tables(self, db: KathDB, query_id: int) -> None:
+        raise NotImplementedError
+
+    def _discover_queries(self) -> List[int]:
+        return list(self.QUERY_IDS)
+
+    # -- KathDB ---------------------------------------------------------------
+
+    def _planner_model(self) -> str:
+        name = self.model_name
+        if "/" in name:
+            return name
+        if "claude" in name:
+            return f"anthropic/{name}"
+        if "gemini" in name:
+            return f"google/{name}"
+        return f"openai/{name}"
+
+    def _open_kathdb(self, tmp_dir: str) -> KathDB:
+        fn_dir = os.environ.get("KATHDB_FN_DIR", "").strip() or str(
+            self.files_path / "kathdb_fn_lib"
+        )
+        Path(fn_dir).mkdir(parents=True, exist_ok=True)
+        return KathDB(
+            Path(tmp_dir) / "catalog.duckdb",
+            planner_model=self._planner_model(),
+            ai_op_model=os.environ.get("KATHDB_AI_OP_MODEL", "").strip() or None,
+            human_in_the_loop=False,
+            logical_rewrite=_env_bool("KATHDB_LOGICAL_REWRITE", True),
+            phy_opt=_env_bool("KATHDB_PHY_OPT", False),
+            prebuilt_functions=_env_bool("KATHDB_PREBUILT_FUNCTIONS", True),
+            generated_functions=_env_bool("KATHDB_GENERATED_FUNCTIONS", True),
+            worker_env=self._worker_env,
+            num_executor_workers=int(os.environ.get("KATHDB_NUM_EXECUTOR_WORKERS", "1")),
+            config=KathDBConfig(generated_fn_dir=fn_dir),
+        )
+
+    def execute_query(self, query_id: int) -> GenericQueryMetric:
+        query_text = self._query_text(query_id)
+        tmp_dir = tempfile.mkdtemp(prefix="kathdb_sembench_")
+        try:
+            db = self._open_kathdb(tmp_dir)
+            try:
+                self._register_tables(db, query_id)
+                t0 = time.perf_counter()
+                result_ctx = db.query(query_text)
+                wall = time.perf_counter() - t0
+                result_df = db.last_result(result_ctx)
+                cost = db.last_cost()
+                # Reuse the worker environment KathDB provisioned for the next query.
+                self._worker_env = self._worker_env or db.worker_env_name
+            finally:
+                db.close()
+        finally:
+            shutil.rmtree(tmp_dir, ignore_errors=True)
+
+        if result_df is None:
+            result_df = self._get_empty_results_dataframe(query_id)
+        stages = cost.stages
+        total = cost.totals()
+        print(cost.summary())
+        return GenericQueryMetric(
+            query_id=query_id,
+            status="success",
+            execution_time=wall,
+            results=result_df,
+            token_usage=total.total_tokens,
+            money_cost=total.money_cost_usd,
+            plan_gen_time=sum(stages[s].wall_time_sec for s in _PLAN_STAGES),
+            plan_gen_money_cost=sum(stages[s].money_cost_usd for s in _PLAN_STAGES),
+            execution_only_time=stages["execution"].wall_time_sec,
+            execution_money_cost=stages["execution"].money_cost_usd,
+        )
+
+    def execute_queries(self, query_ids: List[int]) -> Dict[int, GenericQueryMetric]:
+        results = {}
+        for query_id in query_ids:
+            try:
+                results[query_id] = self.execute_query(query_id)
+            except Exception as e:  # noqa: BLE001 - one failed query must not stop the run
+                print(f"Error executing query {query_id}: {e}")
+                results[query_id] = GenericQueryMetric(
+                    query_id=query_id,
+                    status="failed",
+                    execution_time=0.0,
+                    results=self._get_empty_results_dataframe(query_id),
+                    error=str(e),
+                )
+        return results
+
+    # -- helpers for subclasses ---------------------------------------------------
+
+    def _empty_frame(self, columns: List[str]) -> pd.DataFrame:
+        return pd.DataFrame(columns=columns)

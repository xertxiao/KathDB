+"""KathDB runner for the Additional scenario."""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import pandas as pd
+from kathdb.common.view_schema import Modality
+
+from runner.generic_kathdb_runner.generic_kathdb_runner import GenericKathDBRunner
+from scenario.additional.additional_scenario import ECOMM_QUERY_IDS, AdditionalScenario
+from scenario.ecomm.runner.kathdb_runner.kathdb_runner import register_ecomm_tables
+
+# Product name / description are hidden: the garment kind must come from the image.
+_ECOMM_COLUMNS = ["id", "price", "brandName", "masterCategory", "styleImages"]
+
+
+class KathDBRunner(GenericKathDBRunner):
+    QUERY_IDS = list(range(1, 11))
+
+    def _query_text(self, query_id: int) -> str:
+        return self.scenario_handler.get_nl_query_text(query_id)
+
+    def _register_tables(self, db, query_id: int) -> None:
+        if query_id in ECOMM_QUERY_IDS:
+            register_ecomm_tables(db, Path(AdditionalScenario.ecomm_data_dir()), _ECOMM_COLUMNS)
+            return
+        data_dir = Path(AdditionalScenario.mmqa_data_dir())
+        albums = pd.read_csv(AdditionalScenario.albums_csv())
+        images = pd.read_csv(data_dir / "thalamusdb_images.csv")
+        df = images.merge(albums[["image_filename", "album"]], on="image_filename")
+        df["image_id"] = df["row_id"].astype(int)
+        df["image_path"] = df["image_filename"].apply(lambda f: str(data_dir / "images" / f))
+        db.register_table(
+            df[["album", "image_id", "image_path"]],
+            "images",
+            column_modalities={"image_path": Modality.IMAGE},
+            description=(
+                "A table of images. Columns: album (a given integer album id; each "
+                "image belongs to one album / collection), image_id (integer image "
+                "id), image_path (the image). Decide each image's content from the pixels."
+            ),
+        )
+
+    def _get_empty_results_dataframe(self, query_id: int) -> pd.DataFrame:
+        return self._empty_frame(["id"])

+[metadata]
+query_id = 10
+data = "mmqa images, scale factor 400, grouped into albums (data/mmqa_albums_sf400.csv)"
+modalities = ["image", "tabular"]
+
+[definition]
+natural_language = """
+Each row is an image that belongs to a given album (a collection of images), shown with
+the image itself. By looking only at the image pixels, decide whether each image shows
+one or more people. Among albums that contain at least 10 images, return those that
+contain BOTH at least one image with people AND at least one image with no people.
+Output one row per qualifying album with a single column: id (the album id).
+"""
+# Ground truth: albums satisfying the rule over the frozen per-image labels
+# (subject / has_people) in data/mmqa_albums_sf400.csv; regenerate with make_gt.py.
+ground_truth_rule = "people_mix,size>=10"
+ground_truth = [1003, 1004, 1005, 1006, 1007, 1008]
+accuracy_metric = "f1-score"

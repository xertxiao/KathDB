+    1: ["reviewId"],
+    2: ["reviewId"],
+    3: ["positive_review_cnt"],
+    4: ["positivity_ratio"],
+    5: ["id", "reviewId1", "reviewId2"],
+    6: ["id", "reviewId1", "reviewId2"],

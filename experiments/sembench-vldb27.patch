@@ -0,0 +1,69 @@
+#!/usr/bin/env python3
+"""Ground truth for the album queries (Q5-Q10) from ``data/mmqa_albums_sf400.csv``.
+
+Each image row carries its album and two frozen labels: ``subject`` (main subject,
+a short noun) and ``has_people``. A query's ``ground_truth_rule`` in its TOML file
+names the predicate and the minimum album size:
+
+  subjects>=2   albums with at least two distinct subjects
+  people_mix    albums with at least one people image AND at least one no-people image
+
+Usage: python3 make_gt.py            # print the ground truth per query
+       python3 make_gt.py --write    # also rewrite ``ground_truth`` in the TOML files
+"""
+
+import argparse
+import csv
+import re
+from collections import defaultdict
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+
+
+def load_albums():
+    by_album = defaultdict(list)
+    with open(HERE / "data" / "mmqa_albums_sf400.csv") as f:
+        for r in csv.DictReader(f):
+            by_album[int(r["album"])].append(r)
+    return by_album
+
+
+def ground_truth(rule: str, by_album) -> list[int]:
+    pred, size_min = rule.split(",")
+    size_min = int(size_min.split(">=")[1])
+    out = []
+    for album, rows in by_album.items():
+        if len(rows) < size_min:
+            continue
+        if pred == "subjects>=2":
+            ok = len({r["subject"] for r in rows}) >= 2
+        elif pred == "people_mix":
+            people = {r["has_people"].strip().lower() in ("true", "1") for r in rows}
+            ok = people == {True, False}
+        else:
+            raise ValueError(rule)
+        if ok:
+            out.append(album)
+    return sorted(out)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--write", action="store_true")
+    args = ap.parse_args()
+    by_album = load_albums()
+    for toml in sorted((HERE / "queries").glob("q*.toml")):
+        text = toml.read_text()
+        m = re.search(r'ground_truth_rule\s*=\s*"([^"]+)"', text)
+        if not m:
+            continue
+        gt = ground_truth(m.group(1), by_album)
+        print(f"{toml.name}: {m.group(1)} -> {gt}")
+        if args.write:
+            text = re.sub(r"ground_truth\s*=\s*\[[^\]]*\]", f"ground_truth = {gt}", text)
+            toml.write_text(text)
+
+
+if __name__ == "__main__":
+    main()

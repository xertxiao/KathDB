+"""Evaluator for the Additional scenario: set-F1 over the ``id`` column."""
+
+from __future__ import annotations
+
+import re
+import sys
+from pathlib import Path
+
+import pandas as pd
+
+sys.path.append(str(Path(__file__).parent.parent.parent))
+from evaluator.generic_evaluator import GenericEvaluator  # noqa: E402
+
+sys.path.append(str(Path(__file__).parent.parent))
+from additional.additional_scenario import MMQA_QUERY_IDS, AdditionalScenario  # noqa: E402
+
+
+def _canon_album_ids(df: pd.DataFrame) -> pd.DataFrame:
+    """Album ids may come back as ints, floats or strings; compare their digits."""
+    if df is None or df.empty or "id" not in df.columns:
+        return pd.DataFrame({"id": []})
+    ids = []
+    for v in df["id"].dropna():
+        m = re.findall(r"\d+", str(v))
+        if len(m) == 1:
+            ids.append(m[0])
+    return pd.DataFrame({"id": ids})
+
+
+class AdditionalEvaluator(GenericEvaluator):
+    def __init__(self, use_case: str, scale_factor: int = None) -> None:
+        super().__init__(use_case, scale_factor)
+        self.scenario_handler = AdditionalScenario(scale_factor=scale_factor)
+
+    def _load_domain_data(self) -> None:
+        pass
+
+    def _get_ground_truth(self, query_id: int) -> pd.DataFrame:
+        return self.scenario_handler.get_ground_truth(query_id)
+
+    def _evaluate_single_query(self, query_id, system_results, ground_truth):
+        if int(query_id) in MMQA_QUERY_IDS:
+            system_results = _canon_album_ids(system_results)
+            ground_truth = _canon_album_ids(ground_truth)
+        measure = self.scenario_handler.get_accuracy_measure_for_query(query_id)
+        return GenericEvaluator.compute_accuracy_score(measure, ground_truth, system_results)

+
+def register_ecomm_tables(db, data_path, columns) -> None:
+    """Register ``styles_details`` (restricted to *columns*) and ``image_mapping``."""
+    styles = pd.read_parquet(data_path / "styles_details.parquet")
+    styles = styles[[c for c in columns if c in styles.columns]]
+    images = pd.read_parquet(data_path / "image_mapping.parquet")
+    images["image_path"] = str(data_path / "images") + "/" + images["filename"].astype(str)
+    db.register_table(
+        styles,
+        "styles_details",
+        description=(
+            "A table that contains detailed fashion product information. "
+            f"Available columns: {', '.join(styles.columns)}"
+        ),
+    )
+    db.register_table(
+        images,
+        "image_mapping",
+        column_modalities={"image_path": Modality.IMAGE},
+        description=(
+            "A table that maps product ids to image filenames, links, and image_path "
+            "for the product image"
+        ),
+    )
+
+
+class KathDBRunner(GenericKathDBRunner):
+    QUERY_IDS = list(range(1, 15))
+
+    def _query_text(self, query_id: int) -> str:
+        return self.scenario_handler.queries[int(query_id)]["definition"][
+            "natural_language"
+        ].strip()
+
+    def _register_tables(self, db, query_id: int) -> None:
+        register_ecomm_tables(
+            db, self.data_path, _BASE_COLUMNS + _EXTRA_COLUMNS.get(query_id, [])
+        )
+
+    def _get_empty_results_dataframe(self, query_id: int) -> pd.DataFrame:
+        return self._empty_frame(_EMPTY_SCHEMAS.get(query_id, []))

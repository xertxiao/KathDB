+    def _normalize_id_value(val):
+        """Normalize an ID value for comparison. Strings are lowercased so
+        case-only differences (e.g. 'Adidas' vs 'ADIDAS') don't cause
+        mismatches. If it's a JSON string, parse and re-serialize with a
+        canonical format (then lowercase) so whitespace differences
+        (e.g. '{"id":1}' vs '{"id": 1}') don't cause mismatches either.
+
+        Scalar TYPES inside the JSON are also canonicalized (every leaf coerced
+        to a string, int-valued floats to their int form) so that a value
+        serialized as a string vs a number -- e.g. '{"id":"10579"}' vs
+        '{"id":10579}', which the GT and a model emit interchangeably -- compares
+        equal. Without this, a correct answer that quotes the id scores 0."""
+
+        def _canon(o):
+            if isinstance(o, dict):
+                return {k: _canon(v) for k, v in o.items()}
+            if isinstance(o, list):
+                return [_canon(v) for v in o]
+            if isinstance(o, bool):
+                return str(o).lower()
+            if isinstance(o, float) and o.is_integer():
+                return str(int(o))
+            if isinstance(o, (int, float)):
+                return str(o)
+            return o  # already a string
+
+        if isinstance(val, str):
+            try:
+                parsed = json.loads(val)
+                # Only canonicalize scalar types for real JSON structures
+                # (objects/arrays), where a string-vs-number leaf causes the
+                # mismatch. Leave plain scalars (e.g. a bare numeric id "123")
+                # to the original behavior so their normalized form is unchanged.
+                if isinstance(parsed, (dict, list)):
+                    parsed = _canon(parsed)
+                val = json.dumps(parsed, sort_keys=True, separators=(",", ":"))
+            except (json.JSONDecodeError, TypeError):
+                pass
+            return val.lower()
+        return val

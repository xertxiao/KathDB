+    "1": ["director"],
+    "2a": ["ID", "image_id"],
+    "2b": ["ID", "image_id", "color"],
+    "3a": ["title"],
+    "3f": ["title"],
+    "4": ["genre", "movies_in_genre"],
+    "5": ["actor"],
+    "6a": ["Airlines"],
+    "6b": ["Airlines"],
+    "6c": ["Airlines"],
+    "7": ["Airlines", "image_id"],
+}
+
+# lizzy_caplan_text_data also holds plots of movies she did not appear in; the
+# genre queries (ids 4, 5, 6) ask about her filmography, so the table is scoped to it.
+_LIZZY_CAPLAN_FILMOGRAPHY = [
+    "127 Hours", "3, 2, 1... Frankie Go Boom", "Allied", "Bachelorette", "Cloverfield",
+    "Cobweb", "Crashing", "Crossing Over", "Extinction", "High Road",
+    "Hot Tub Time Machine", "Item 47", "Love Is the Drug", "Mean Girls",
+    "My Best Friend's Girl", "Now You See Me 2", "Orange County", "Queens of Country",
+    "Save the Date", "The Disaster Artist", "The Interview",
+    "The Last Rites of Ransom Pride", "The Night Before",
+    "The People We Hate at the Wedding",
+]
+_FILMOGRAPHY_QUERY_IDS = {4, 5, 6}
+
+
+class KathDBRunner(GenericKathDBRunner):
+    QUERY_IDS = list(range(1, 12))
+
+    def _query_text(self, query_id: int) -> str:
+        name = _MMQA_ID_TO_NAME[int(query_id)]
+        with open(self.query_path / "natural_language" / f"q{name}.json") as f:
+            return json.load(f)["nl_question"]
+
+    def _register_tables(self, db, query_id: int) -> None:
+        ben_piazza = self.load_data("ben_piazza.csv")
